+// ۵۰ اعتبار کاملاً مصرف‌شده (بدون باقی‌مانده) لابه‌لای همان بازه
+for (let i = 0; i < 50; i++) insCredit.run(`S175U${i}`, 1000, 1000, 1, 'USED', 'MANUAL', null, user, now - 60_000 + i * 7, today, now - 60_000 + i * 7, now)
