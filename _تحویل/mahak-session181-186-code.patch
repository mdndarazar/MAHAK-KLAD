+  const x = toRial(a)
+  const y = toRial(b)
+  return x < y ? -1 : x > y ? 1 : 0
+}
+
+/** جایگزین `Math.max` که روی bigint می‌ترکد. آرایه‌ی خالی ⇒ `0n`. */
+export function maxRial(...values: RialLike[]): bigint {
+  let best: bigint | null = null
+  for (const v of values) {
+    const x = toRial(v)
+    if (best === null || x > best) best = x
+  }
+  return best ?? 0n
