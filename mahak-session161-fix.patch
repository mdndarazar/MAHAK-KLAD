+  eq('چک نامشخصِ فاکتور قبلی در priorClearedCheques نیست', t.priorClearedCheques, 0)
+  eq('و در priorPeriod نیست', t.priorPeriod, 0)
+  eq('ولی در clearedUnknownCheques هست', t.clearedUnknownCheques, CHQ)
