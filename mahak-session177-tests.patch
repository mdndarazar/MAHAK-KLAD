 eq('هیچ in بالای ۵۰۰ نبود (deleteBatches)', maxIn <= 500, true)
 
 console.log('\n۸) ۵۲۰ ردیف سابقه: فهرست (batches) و حذف گروهی بدون بازگردانی')
