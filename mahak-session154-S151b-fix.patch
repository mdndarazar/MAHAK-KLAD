+interface SalePriceOverride {
+  variantId: number
+  code: string
+  qty: number
+  refPrice: number
+  enteredPrice: number
+  source: 'INVOICE' | 'CATALOG'
+}
+
+interface SalePricingCheck {
+  /** رمز مدیر همین درخواست سنجیده و پذیرفته شد (برای preverify بعدی، فقط یک بار) */
+  managerApproved: boolean
