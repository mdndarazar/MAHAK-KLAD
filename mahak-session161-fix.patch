+  const t = calculatePaymentTotals([
+    { amount: CHQ, kind: 'CHEQUE', chequeStatus: 'CLEARED', clearedAt: new Date(), destination: null, invoiceIssuedAt: new Date(Date.now() - 48 * HOUR) }
