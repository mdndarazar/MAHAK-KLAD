+
+// ---------------------------------------------------------------------------
+console.log('\n۱) ابطال بازه‌ی امروز با ۵۲۱ فاکتور، ۵۱۰ برگشت دارای اعتبار، ۵۱۰ مصرف اعتبار')
+const ids1 = await makeBatch(520, 'R')
