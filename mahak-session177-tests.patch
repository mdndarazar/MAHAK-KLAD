+const w1 = (list ?? []).find((r) => r.id === X1?.batchId)?.revertWarning ?? null
+eq('هشدار هم‌پوشانی X1 روی ۳ کالا', typeof w1 === 'string' && w1.includes(`روی ${faDigits(3)} مورد`), true)
